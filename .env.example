# TiltCheck environment template
# Copy to .env for local use. Never commit real secrets.

# --- Database (required by API) ---
DATABASE_URL=postgresql://user:password@localhost:5432/tiltcheck

# --- Clerk auth (required for signed-in app) ---
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# --- Web build / routing ---
# Defaults to / and only needs changing when the web app is mounted below a path.
BASE_PATH=/
# Dev/preview defaults to 5173; API defaults to 8080 when PORT is unset.
PORT=8080

# --- Hosting / network ---
# Number of trusted reverse-proxy hops in front of the API. 0 = direct connection.
TRUST_PROXY_HOPS=0
# Comma-separated frontend origins only when web + API are on different origins.
# Example: ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com
ALLOWED_ORIGINS=

# --- AI (required for AI narrative/coaching features) ---
OPENAI_API_KEY=replace_me
# Optional for OpenAI-compatible gateways. Leave blank for the standard OpenAI API.
OPENAI_BASE_URL=

# --- Billing (optional until enabled) ---
WHOP_API_KEY=

# --- Beta controls ---
# 0 = unlimited. Any positive integer reinstates a beta seat ceiling.
BETA_SEAT_LIMIT=0

# --- Push notifications (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tiltcheck.app
