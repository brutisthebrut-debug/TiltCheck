# Runtime
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=1

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiltcheck

# Clerk
# The publishable key is intentionally available to both the browser build and
# API. The secret key must only be stored in the host's secret manager.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Whop — only required when testing a second Crew purchase.
WHOP_API_KEY=replace_me
WHOP_COMPANY_ID=replace_me
WHOP_PLAN_ID=replace_me

# OpenAI — Arc and generated weekly narratives degrade gracefully without it.
AI_INTEGRATIONS_OPENAI_API_KEY=replace_me

# Web Push — optional. Generate a fresh pair; never reuse the compromised key
# that was present in the old public Replit configuration.
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:ops@example.com

# Beta controls
FOUNDER_EMAIL=founder@example.com
BETA_SEAT_LIMIT=5
BETA_TESTER_TARGET=5
# Leave empty to use the founder-managed invite list in the app.
BETA_ALLOWED_EMAILS=

# Local frontend
FRONTEND_PORT=5173
API_DEV_ORIGIN=http://127.0.0.1:3000
BASE_PATH=/
